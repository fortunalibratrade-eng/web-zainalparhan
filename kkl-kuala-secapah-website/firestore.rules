rules_version = '2';

// Aturan keamanan untuk KKL Kuala Secapah 1
// - Siapa saja bisa MEMBACA data (transparansi untuk semua anggota, tanpa perlu login)
// - Hanya pengguna yang SUDAH LOGIN (akun bendahara di Firebase Authentication)
//   yang bisa menambah, mengubah, atau menghapus data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
